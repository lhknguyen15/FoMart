{
  "ConnectionStrings": {
    "FoMart": ""
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console", "Args": { "formatProvider": "System.Globalization.CultureInfo::InvariantCulture" } }
    ]
  },
  "AllowedHosts": "*"
}

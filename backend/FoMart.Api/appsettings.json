{
  "ConnectionStrings": {
    "FoMart": ""
  },
  "Jwt": {
    "Issuer": "FoMart.Api",
    "Audience": "FoMart.Web",
    "SigningKey": "",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "RateLimiting": {
    "AuthPermitLimit": 10
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatProvider": "System.Globalization.CultureInfo::InvariantCulture"
        }
      }
    ]
  },
  "AllowedHosts": "*"
}
